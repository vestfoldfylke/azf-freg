{
  "name": "azf-freg",
  "version": "2.3.0",
  "type": "module",
  "main": "dist/functions/*.js",
  "description": "Azure function for calling FREG",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test:node": "tsc && node --test --experimental-strip-types 'src/**/*.test.ts'",
    "test": "npm run lint && npm run test:node",
    "start": "npm run build && func start",
    "lint": "npx @biomejs/biome check",
    "lint:fix": "npx @biomejs/biome check --write",
    "lint:fix:unsafe": "npx @biomejs/biome check --write --unsafe",
    "encode-private-key": "node dev/encode-private-key-pem.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^25.9.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@azure/functions": "^4.16.2",
    "@vestfoldfylke/loglady": "^2.1.0",
    "jose": "^6.2.7",
    "openid-client": "^6.8.4"
  }
}
