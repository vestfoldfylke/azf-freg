{
  "name": "azf-freg",
  "version": "2.1.0",
  "type": "module",
  "description": "Azure function for calling FREG",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test 'dist/tests/**/*.test.js'",
    "start": "npm run build && func start",
    "lint": "npx @biomejs/biome check",
    "lint:fix": "npx @biomejs/biome check --write",
    "lint:fix:unsafe": "npx @biomejs/biome check --write --unsafe",
    "refresh": "rm -rf node_modules/ && rm package-lock.json && npm i",
    "dev": "npm run build && func start"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/node": "^25.9.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@vestfoldfylke/loglady": "^1.5.3",
    "jose": "^6.2.3",
    "openid-client": "^6.8.4"
  }
}
